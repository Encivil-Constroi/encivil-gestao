# Supabase — obter em: https://supabase.com/dashboard/project/<project-id>/settings/api
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sentry — obter em: https://sentry.io → Settings → Projects → <project> → Client Keys (DSN)
# Deixar vazio em desenvolvimento para desativar o Sentry
VITE_SENTRY_DSN=

# NUNCA adicionar aqui:
# - sb_secret_... (Secret key — usar apenas no dashboard ou funções servidor)
# - Senhas de banco de dados
