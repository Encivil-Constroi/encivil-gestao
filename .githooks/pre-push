#!/bin/sh
# ENCIVIL — pre-push hook (versionado; aplicado por core.hooksPath=.githooks)
#
# Verifica se o bundle compila sem erros antes de enviar para o remoto.
# Um erro de build só seria detetado pelo Cloudflare Pages após o push — este
# hook apanha-o localmente em segundos.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

if command -v npm >/dev/null 2>&1 && [ -d node_modules ]; then
  echo "${YELLOW}A compilar bundle (npm run build)…${NC}"
  if ! npm run build --silent 2>&1; then
    echo ""
    echo "${RED}Push bloqueado: o bundle não compila.${NC}"
    echo "${YELLOW}Corrige os erros antes de fazer push.${NC}"
    echo "Para ignorar (usar com cuidado): git push --no-verify"
    echo ""
    exit 1
  fi
  echo "${GREEN}Build OK.${NC}"
fi

exit 0
