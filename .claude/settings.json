{
  "permissions": {
    "allow": [
      "PowerShell(cd *)",
      "PowerShell(Set-Location *)",
      "PowerShell(Get-ChildItem *)",
      "Bash(npx tsc --noEmit *)",
      "PowerShell(Start-Sleep *)",
      "PowerShell(Get-Process *)",
      "PowerShell(netstat *)",
      "Bash(npm run test *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Test-Path *)",
      "PowerShell(dir *)",
      "PowerShell(docker ps *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(npm run build *)",
      "Bash(npm run dev *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(npx vite build *)",
      "Bash(supabase db push *)",
      "Bash(supabase db query *)",
      "Bash(supabase db diff *)",
      "Bash(supabase migration *)",
      "Bash(vercel *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash(supabase db push*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'LEMBRETE ENCIVIL: Regenerar tipos — npx supabase gen types typescript --local > src/integrations/supabase/types.ts && npm run typecheck'"
          }
        ]
      },
      {
        "matcher": "Bash(supabase migration new*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'LEMBRETE ENCIVIL: Adicionar GRANTs explícitos à migration (Automatically expose new tables está OFF)'"
          }
        ]
      }
    ]
  }
}
